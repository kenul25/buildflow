# Pass public API configuration at build/run time. Android emulators reach the
# host using 10.0.2.2; physical devices need the host machine's LAN address.
flutter run --dart-define=API_BASE_URL=http://10.0.2.2:5144/api

# Physical Android device connected through USB (run adb reverse first).
adb reverse tcp:5144 tcp:5144
flutter run --dart-define=API_BASE_URL=http://127.0.0.1:5144/api
